{
  "profile": "awiki.message-sync.explicit-negotiation.v1",
  "cases": [
    {
      "name": "legacy-p6",
      "capabilities": {
        "sync_profile": "anp.sync.local.v2",
        "event_schema_max": 1,
        "p6_delivery": "p6.delivery_context.v1"
      },
      "expected": "legacy"
    },
    {
      "name": "extended-zero",
      "capabilities": {
        "sync_profile": "anp.sync.local.v2",
        "event_schema_max": 1,
        "requested_sync_capabilities": []
      },
      "expected_negotiated": []
    },
    {
      "name": "extended-p5",
      "capabilities": {
        "sync_profile": "anp.sync.local.v2",
        "event_schema_max": 1,
        "requested_sync_capabilities": ["lanes.p5_device.v1"]
      },
      "expected_negotiated": ["lanes.p5_device.v1"]
    },
    {
      "name": "extended-p6",
      "capabilities": {
        "sync_profile": "anp.sync.local.v2",
        "event_schema_max": 1,
        "requested_sync_capabilities": [
          "lanes.p6_group.v1",
          "p6.delivery_context.v1"
        ],
        "p6_delivery": "p6.delivery_context.v1"
      },
      "expected_negotiated": ["lanes.p6_group.v1"]
    },
    {
      "name": "extended-all",
      "capabilities": {
        "sync_profile": "anp.sync.local.v2",
        "event_schema_max": 1,
        "requested_sync_capabilities": [
          "lanes.p5_device.v1",
          "lanes.p6_group.v1",
          "p6.delivery_context.v1"
        ],
        "p6_delivery": "p6.delivery_context.v1"
      },
      "expected_negotiated": [
        "lanes.p5_device.v1",
        "lanes.p6_group.v1"
      ]
    },
    {
      "name": "extended-installation-legacy-rollback-suspended",
      "existing_negotiation": {
        "requested_capabilities": [],
        "negotiated_capabilities": [],
        "activation_state": "active"
      },
      "capabilities": {
        "sync_profile": "anp.sync.local.v2",
        "event_schema_max": 1
      },
      "expected_activation_state": "suspended",
      "expected_error": {
        "code": 4220,
        "anp_code": "sync.client_upgrade_required"
      }
    },
    {
      "name": "unknown-rejected",
      "capabilities": {
        "sync_profile": "anp.sync.local.v2",
        "event_schema_max": 1,
        "requested_sync_capabilities": ["lanes.future.v1"]
      },
      "expected_error": {
        "code": 4200,
        "anp_code": "sync.invalid_request"
      }
    },
    {
      "name": "unpaired-p6-rejected",
      "capabilities": {
        "sync_profile": "anp.sync.local.v2",
        "event_schema_max": 1,
        "requested_sync_capabilities": ["lanes.p6_group.v1"]
      },
      "expected_error": {
        "code": 4200,
        "anp_code": "sync.invalid_request"
      }
    }
  ]
}
